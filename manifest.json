{
  "manifest_version": 3,
  "name": "SniperShot",
  "version": "1.0.0",
  "description": "Turn any webpage into a sniper game: scope in, spare the civilians, stop the bombers and land the perfect headshot.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "SniperShot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
